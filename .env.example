# Generate .env with: python -m app.cli init
# For a Cloudflare Tunnel, use APP_ENV=production and its public HTTPS origin.
APP_ENV=development
PUBLIC_URL=http://localhost:3000
# Generated during init. Keep the password hash and both random keys private.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# From the Kite developer console; KITE_USER_ID is your Zerodha client ID.
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
# Paper orders are simulated. Real orders require all three live settings.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
DATA_DIR=data
PAPER_CAPITAL=100000
LIVE_CAPITAL=0
# Fractions, not percentage-point numbers: 0.10 means 10%.
MAX_POSITION_PCT=0.10
RISK_PER_TRADE_PCT=0.0025
DAILY_LOSS_PCT=0.01
MAX_POSITIONS=5
# India Standard Time (Asia/Kolkata).
ENTRY_CUTOFF=14:45
EXIT_TIME=15:10
MAX_SPREAD_PCT=0.003
MIN_DAILY_TURNOVER=10000000
# 0 workers selects automatic capacity; CPU workers are separate from Uvicorn.
ANALYTICS_WORKERS=0
ANALYTICS_RESERVE_CPUS=4
ANALYTICS_BATCH_SIZE=32
